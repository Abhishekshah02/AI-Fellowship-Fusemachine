# Copy this file to .env and fill in real values. Never commit the real .env.

POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=your_database_name
POSTGRES_PORT=5433

# SQLAlchemy connection string used by the FastAPI app
DATABASE_URL=postgresql+psycopg2://your_username:your_secure_password@localhost:5433/your_database_name
