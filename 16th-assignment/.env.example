# ============================================================================
#  Copy to .env and fill in ONE provider. Either can be primary; the other
#  automatically becomes the fallback.
#      PROVIDER=openai  -> any OpenAI-compatible endpoint (free options below)
#      PROVIDER=claude  -> Anthropic API
# ============================================================================
PROVIDER=openai

# ---------------------------------------------------------------------------
#  OPTION A (recommended, free) — Groq.  No credit card. Supports tool calling.
#  Get a key: https://console.groq.com/keys
#  Free tier: ~14,400 requests/day, 30/min.
#  Check what your account can use:  curl -H "Authorization: Bearer $KEY" \
#     https://api.groq.com/openai/v1/models
# ---------------------------------------------------------------------------
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
#  OPTION B (free) — Google Gemini, via its OpenAI-compatible endpoint.
#  Get a key: https://aistudio.google.com/apikey     Free: 15/min, 1,500/day.
#
#  OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#  OPENAI_MODEL=gemini-2.5-flash
#  OPENAI_API_KEY=
#
#  OPTION C (free) — OpenRouter, models with the :free suffix.
#  Get a key: https://openrouter.ai/keys             Free: ~20/min, 200/day.
#
#  OPENAI_BASE_URL=https://openrouter.ai/api/v1
#  OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free
#  OPENAI_API_KEY=
#
#  OPTION D (free, no key at all) — a model on your own machine.
#  vLLM:    docker compose --profile gpu up      (needs an NVIDIA GPU)
#  Ollama:  ollama serve && ollama pull llama3.1
#
#  OPENAI_BASE_URL=http://localhost:8000/v1      # Ollama: http://localhost:11434/v1
#  OPENAI_MODEL=mistralai/Mistral-7B-Instruct-v0.3
#  OPENAI_API_KEY=EMPTY
# ---------------------------------------------------------------------------

# ---- Claude (leave blank if you are using a free provider) -----------------
ANTHROPIC_API_KEY=
PRIMARY_MODEL=claude-opus-5

# ---- Generation ------------------------------------------------------------
MAX_TOKENS=1024
# Sampling. Every OpenAI-compatible model accepts these, so with PROVIDER=openai
# they are live on the primary path. claude-opus-5 / claude-sonnet-5 reject
# temperature+top_p and are tuned with EFFORT instead (low|medium|high|xhigh|max).
TEMPERATURE=0.2
TOP_P=0.9
EFFORT=medium

# ---- RAG -------------------------------------------------------------------
TOP_K=3
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# ---- agent (W16) -----------------------------------------------------------
# Hard cap on loop iterations, and verifier round-trips before escalating.
AGENT_MAX_STEPS=10
AGENT_MAX_REVISIONS=2
# Leave VERIFIER_MODEL unset to audit with the same model as the investigator.
# NOTE: no inline comments on a blank value -- dotenv keeps the comment as the
# value, and the verifier then calls a model named "# blank = same model...".
# VERIFIER_MODEL=

# ---- reliability / performance --------------------------------------------
RATE_LIMIT_PER_MINUTE=30
MAX_RETRIES=4
REQUEST_TIMEOUT=60
# A rate-limit window needs more than 8s to clear.
RETRY_MAX_DELAY=25
CACHE_TTL_SECONDS=900
CACHE_MAX_ENTRIES=512
ROUTER_MIN_CONFIDENCE=0.35
